# ==============================================================================
# Ram Prasad Agencies (TheWatchStore.in) — Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Admin Studio Authentication Credentials
ADMIN_USER=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=your_random_secure_secret_key

# Vite Admin Credentials (for admin frontend)
VITE_ADMIN_USER=your_admin_username
VITE_ADMIN_PASS=your_secure_admin_password

# Database Connection (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/ram_prasad_agencies
MONGO_DB_NAME=ram_prasad_agencies

# Ports
PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=5173
ADMIN_PORT=3000
GATEWAY_PORT=80

# Service URLs
VITE_API_ROOT=http://localhost:5000
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Custom Clean Domain Routing
CUSTOM_FRONTEND_DOMAIN=http://ramprasadwatchstore.in
CUSTOM_ADMIN_DOMAIN=http://admin.ramprasadwatchstore.in
INSTANT_FRONTEND_DOMAIN=http://ramprasadwatchstore.lvh.me
INSTANT_ADMIN_DOMAIN=http://admin.ramprasadwatchstore.lvh.me

# Store Identity & Customer Concierge Contacts
STORE_NAME="Ram Prasad Agencies"
STORE_TAGLINE="TheWatchStore.in • Golghar, Gorakhpur"
STORE_CONCIERGE_PHONE="+91 98765 43210"
STORE_WHATSAPP_NUMBER="919876543210"
VITE_WHATSAPP_PHONE=919876543210
